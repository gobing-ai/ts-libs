{
    "name": "@gobing-ai/ts-ai-decision",
    "version": "0.6.2",
    "description": "@gobing-ai/ts-ai-decision — Declarative YAML decision catalog over the ts-ai-runner DecisionMaker surface.",
    "keywords": [
        "typescript",
        "ai",
        "decision",
        "catalog",
        "llm"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gobing-ai/ts-libs.git",
        "directory": "packages/ai-decision"
    },
    "author": "Robin Min <minlongbing@gmail.com>",
    "contributors": [
        "Robin Min <minlongbing@gmail.com>"
    ],
    "type": "module",
    "private": false,
    "sideEffects": false,
    "license": "Apache-2.0",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./schemas/*": "./schemas/*",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "src",
        "schemas",
        "examples",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json && bun ../../scripts/builder.ts fix-dist-esm-extensions dist",
        "test": "NODE_ENV=test bun test --coverage --coverage-dir=.coverage --reporter=dots",
        "test:full": "NODE_ENV=test bun test --update-snapshots --coverage --coverage-dir=.coverage",
        "typecheck": "tsc --noEmit",
        "lint": "biome check . && bun run typecheck",
        "format": "biome check . --write",
        "check": "bun run lint && bun run test",
        "prepublishOnly": "bun ../../scripts/builder.ts check-publish-manifest . && bun run build",
        "release": "echo 'Manual publish is disabled. Releases go through GitHub Actions via Trusted Publishing — push a tag: git tag @gobing-ai/ts-ai-decision-v<version> && git push --tags' && exit 1"
    },
    "dependencies": {
        "@gobing-ai/ts-ai-runner": "workspace:*",
        "@gobing-ai/ts-decision-fm": "workspace:*",
        "@gobing-ai/ts-runtime": "workspace:*",
        "@typesafe-ai/sdk": "0.7.0",
        "zod": "^4.1.0"
    },
    "optionalDependencies": {
        "@gobing-ai/ts-laya-mlx": "workspace:*"
    },
    "devDependencies": {
        "@gobing-ai/ts-utils": "workspace:*",
        "@types/bun": "1.4.3"
    },
    "publishConfig": {
        "access": "public"
    }
}
